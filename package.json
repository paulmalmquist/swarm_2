{
  "name": "swarm_2",
  "version": "0.1.0",
  "private": true,
  "description": "A persistent, coordinated organization of agent swarms with a protected self-improvement loop. Execution and improvement layer beneath an existing chief of staff.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "swarm2": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "serve": "node --disable-warning=ExperimentalWarning src/cli.ts serve",
    "demo:a": "node --disable-warning=ExperimentalWarning demos/run.ts a",
    "demo:b": "node --disable-warning=ExperimentalWarning demos/run.ts b",
    "demo:c": "node --disable-warning=ExperimentalWarning demos/run.ts c",
    "demo:d": "node --disable-warning=ExperimentalWarning demos/run.ts d",
    "demo:e": "node --disable-warning=ExperimentalWarning demos/run.ts e",
    "demo:f": "node --disable-warning=ExperimentalWarning demos/run.ts f",
    "demo:g": "node --disable-warning=ExperimentalWarning demos/run.ts g",
    "demo:all": "node --disable-warning=ExperimentalWarning demos/run.ts all",
    "verify": "npm run typecheck && npm test && npm run demo:all",
    "demo:h": "node --disable-warning=ExperimentalWarning demos/run.ts h",
    "demo:i": "node --disable-warning=ExperimentalWarning demos/run.ts i",
    "demo:live": "node --disable-warning=ExperimentalWarning demos/live.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  }
}
